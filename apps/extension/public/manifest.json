{
  "manifest_version": 3,
  "name": "shadowinput",
  "version": "0.1.0",
  "version_name": "0.1.0-preview.2",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "webNavigation", "activeTab", "scripting", "contextMenus", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://auth.openai.com/*", "https://api.openai.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "app/background.js", "type": "module"},
  "action": {"default_title": "shadowinput", "default_popup":"popup.html"},
  "commands": {
    "toggle":{"suggested_key":{"default":"Alt+Shift+T"},"description":"__MSG_toggle__"},
    "input":{"suggested_key":{"default":"Alt+Shift+I"},"description":"__MSG_input__"}
  },
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-256.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://auth.openai.com https://api.openai.com"}
}
